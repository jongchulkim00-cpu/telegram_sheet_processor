# Stock API runtime settings
API_HOST=0.0.0.0
API_PORT=8010

# Keep stale cache blocked in production.
ALLOW_STALE_CACHE=false

# Optional: Korea Investment Securities KIS Open API.
# Fill these only when you want broker-grade realtime quotes.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_HTS_ID=
KIS_IS_MOCK=true

# Optional: Kiwoom Securities.
# Kiwoom OpenAPI+ is Windows/COM based and usually cannot run inside Linux Docker.
# Use a separate Windows bridge when you want Kiwoom realtime quotes.
KIWOOM_ENABLED=false
KIWOOM_ACCOUNT_NO=
KIWOOM_BRIDGE_URL=

# Optional: external HTTPS access through Cloudflare Tunnel.
# Recommended over opening 8010 directly to the public internet.
CLOUDFLARED_TOKEN=
