# Stock API runtime settings
API_HOST=0.0.0.0
API_PORT=8010

# Keep stale cache blocked in production.
ALLOW_STALE_CACHE=false
MAX_CLAIM_PRICE_DIFF_PCT=1.0

# Optional: Korea Investment Securities KIS Open API.
# Fill these only when you want broker-grade realtime quotes.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_HTS_ID=
KIS_IS_MOCK=true

# Optional: Kiwoom Securities.
# Kiwoom OpenAPI+ is Windows/COM based and usually cannot run inside Linux Docker.
# If you have a Kiwoom REST-style bridge service running on the home server, set the REST values below.
KIWOOM_ENABLED=false
KIWOOM_ACCOUNT_NO=
KIWOOM_BRIDGE_URL=
KIWOOM_REST_ENABLED=false
# Direct Kiwoom REST mode inside the stock API container. Leave quote URL empty for direct mode.
KIWOOM_REST_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_REST_APP_KEY=
KIWOOM_REST_APP_SECRET=
KIWOOM_REST_QUOTE_URL=
KIWOOM_REST_METHOD=GET
KIWOOM_REST_HEADERS_JSON={"Content-Type":"application/json"}
KIWOOM_REST_BODY_JSON={}
KIWOOM_REST_TIMEOUT_SECONDS=10

# Optional: only for the standalone Kiwoom REST bridge process.
# Do not commit real values.
KIWOOM_BRIDGE_MODE=mock
KIWOOM_BRIDGE_HOST=0.0.0.0
KIWOOM_BRIDGE_PORT=8080

# Optional: external HTTPS access through Cloudflare Tunnel.
# Recommended over opening 8010 directly to the public internet.
CLOUDFLARED_TOKEN=
